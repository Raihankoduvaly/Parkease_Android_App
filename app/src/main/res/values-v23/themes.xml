<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ToolBar theme with light Material Design -->
    <style name="ToolBar" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@color/maroon</item>
        <item name="colorPrimaryDark">@color/maroon</item>
        <item name="colorAccent">@color/maroon</item>
        <item name="android:textColorPrimary">@color/white</item>
    </style>

    <!-- ToolBarCar theme with light Material Design and custom toolbar style -->
    <style name="ToolBarCar" parent="Theme.MaterialComponents.Light">
        <item name="colorPrimary">@color/maroon</item>
        <item name="colorPrimaryDark">@color/maroon</item>
        <item name="colorAccent">@color/maroon</item>
        <item name="android:textColorPrimary">@color/black</item>
        <item name="toolbarStyle">@style/CustomToolbar</item>
    </style>

    <!-- NoToolBar theme for no action bar, using Material Components style -->
    <style name="NoToolBar" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/maroon</item>
        <item name="colorPrimaryDark">@color/maroon</item>
        <item name="colorAccent">@color/maroon</item>
        <item name="android:textColorPrimary">@color/maroon</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Custom toolbar style with white text color -->
    <style name="CustomToolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:titleTextColor">@color/white</item>
        <item name="android:subtitleTextColor">@color/white</item>
    </style>

    <!-- ToolBarDark theme with no action bar and dark status bar -->
    <style name="ToolBarDark" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/maroon</item>
        <item name="colorPrimaryDark">@color/maroon</item>
        <item name="colorAccent">@color/maroon</item>
        <item name="android:textColorPrimary">@color/maroon</item>
        <item name="android:statusBarColor">@color/maroon</item>
    </style>

</resources>
